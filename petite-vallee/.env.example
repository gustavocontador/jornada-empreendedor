# ─────────────────────────────────────────────────────────────
# Petite Vallée — variáveis de ambiente
#
# Copie este arquivo para `.env.local` e preencha os valores.
# NUNCA faça commit de chaves reais no GitHub.
# ─────────────────────────────────────────────────────────────

# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Pagamentos ───────────────────────────────────────────────
# Provedor de pagamento. Enquanto estiver vazio ou "demo",
# o site funciona em MODO DE DEMONSTRAÇÃO: nenhuma cobrança
# real é criada. Valores futuros possíveis: "mercadopago",
# "pagarme", "asaas", etc. (ver src/lib/payment/README.md)
PAYMENT_PROVIDER=demo

# Chave pública do gateway (pode ser exposta ao navegador
# através da biblioteca oficial do provedor)
PAYMENT_PUBLIC_KEY=

# Token de acesso privado do gateway (SOMENTE servidor)
PAYMENT_ACCESS_TOKEN=

# Segredo para validar a autenticidade dos webhooks do gateway
PAYMENT_WEBHOOK_SECRET=
